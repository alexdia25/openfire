; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Return Fire"
config/use_custom_user_dir=true
config/custom_user_dir_name="OpenFire"
config/description="A from-scratch, data-driven Godot 4 reimplementation of Return Fire (1996, Silent Software). Ships no original assets or decompiled code -- see docs/PORTING_PLAN.md."
run/main_scene="res://importer/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/open_fire_export/plugin.cfg", "res://addons/openfire_engine/plugin.cfg")

[openfire]

packs/base_pack="res://packs/original_pc"
packs/base_pack.openfire_import="user://packs/original_pc"
editor/asset_registry="res://packs/registry/asset_ids.json"

[physics]

common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
